# Context Orchestration Engine - worker credentials
#
# Each worker in config/workers.json names the env var it reads via
# "api_key_env". Nothing else in the system knows which provider is behind it.
#
# Copy this file to .env and fill in the workers you actually want to run:
#   cp .env.example .env
#
# Any worker without a resolvable key makes `python main.py run` fall back to
# the offline mock gateway. Pass --real to force live calls.

WORKER_1_API_KEY=
WORKER_2_API_KEY=
WORKER_3_API_KEY=
WORKER_4_API_KEY=
WORKER_5_API_KEY=

# Several workers may share one key - point them at the same env var in
# config/workers.json, or reuse the same value here.
#
# Example: run all five workers on one provider by setting every worker's
# "model" to that provider's model string and every "api_key_env" to
# WORKER_1_API_KEY.

# ---------------------------------------------------------------------------
# Deployment flags (see docs/DEPLOYMENT.md). Leave these unset locally.
# ---------------------------------------------------------------------------
#
# COE_SERVERLESS=1   The playground starts and streams a run in one request,
#                    and live model calls are closed. vercel.json sets this.
# COE_ALLOW_LIVE=1   Reopens live model calls on a serverless deployment.
#                    Only for a private one that carries its own keys.
# COE_DB=/tmp/playground.db
#                    Where the deployed app writes SQLite.
